{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  // The rule: `src/tui/**` itself must never import `electron` directly — it
  // runs standalone under tsx, outside an Electron process. `src/main/paths.ts`
  // is excluded from `include` because IT imports `electron`; it is NOT excluded
  // from the compile, though — `hub/discover.ts` imports `agentsCodeDir` from
  // `../paths`, so `paths.ts` (and electron's own bundled types) still gets
  // pulled in transitively for type-checking. That's known and harmless:
  // `tsc --noEmit` only analyzes types here, it never executes anything, and
  // electron's `.d.ts` resolves fine regardless of `"types": ["node"]` (that
  // option only limits automatic `@types/*` inclusion, not explicit imports).
  // `src/main/hub/**` is narrowed to `discover.ts` and `process.ts` only —
  // `hub/runner.ts` and `hub/agent-info.ts` import `../agents/rules` and
  // `../agents/questions`, which this spike does not need and which pull in
  // more of the Electron-main surface than the TUI should depend on. Later
  // tasks add their own files here as the TUI grows.
  "include": ["src/tui/**/*", "src/main/core/**/*", "src/main/hub/discover.ts", "src/main/hub/process.ts"],
  "compilerOptions": {
    "composite": false,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  }
}
