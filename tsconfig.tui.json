{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  // `src/main/paths.ts` is excluded on purpose: it imports `electron`, and the
  // TUI must never import electron (it runs standalone under tsx, outside an
  // Electron process). `src/main/hub/**` is narrowed to `discover.ts` and
  // `process.ts` only — `hub/runner.ts` and `hub/agent-info.ts` import
  // `../agents/rules` and `../agents/questions`, which this spike does not
  // need and which pull in more of the Electron-main surface than the TUI
  // should depend on. Later tasks add their own files here as the TUI grows.
  "include": ["src/tui/**/*", "src/main/core/**/*", "src/main/hub/discover.ts", "src/main/hub/process.ts"],
  "compilerOptions": {
    "composite": false,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  }
}
