{
  "name": "albus-agent",
  "version": "1.0.0",
  "description": "Albus Agent — worker de extracción sobre My Notes",
  "main": "./out/main/index.js",
  "author": "jdiaz483",
  "private": true,
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:tui": "tsc --noEmit -p tsconfig.tui.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:tui",
    "setup": "tsx --tsconfig tsconfig.tui.json src/tui/index.tsx",
    "logo:render": "tsx scripts/render-logo.ts",
    "setup:check": "tsx scripts/check-setup.ts",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "jobs": "node scripts/run-jobs.mjs",
    "jobs:login": "node scripts/run-jobs.mjs login",
    "jobs:apply": "node scripts/run-jobs.mjs apply",
    "jobs:selftest": "node scripts/run-jobs.mjs selftest",
    "nav:check": "node scripts/run-jobs.mjs nav",
    "nav:inspect": "node scripts/run-jobs.mjs inspect",
    "notion:check": "tsx scripts/check-notion.ts",
    "drive:check": "tsx scripts/check-drive.ts",
    "ipc:check": "tsx scripts/check-ipc.ts",
    "video:check": "tsx scripts/check-video.ts",
    "jobs:check": "tsx scripts/check-jobs.ts && tsx scripts/check-agents.ts && tsx scripts/check-ipc.ts",
    "jobs:check:live": "tsx scripts/check-live.ts",
    "gmail:auth": "tsx scripts/gmail-auth.ts",
    "ui:selftest": "node scripts/run-jobs.mjs ui",
    "udemy:check": "tsx scripts/check-udemy.ts",
    "udemy:login": "node scripts/run-jobs.mjs udemy-login",
    "udemy": "node scripts/run-jobs.mjs udemy",
    "udemy:whoami": "node scripts/run-jobs.mjs udemy-whoami",
    "udemy:transcripts": "tsx scripts/udemy-transcripts.ts",
    "hub:check": "tsx scripts/check-hub.ts",
    "hub": "tsx scripts/hub.ts"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@supabase/supabase-js": "^2.45.0",
    "@types/cytoscape": "^3.21.9",
    "@types/ws": "^8.18.1",
    "cytoscape": "^3.34.0",
    "cytoscape-fcose": "^2.2.0",
    "dotenv": "^17.4.2",
    "ink": "^8.0.0",
    "ink-text-input": "^6.0.0",
    "jsqr": "^1.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "ws": "^8.21.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^5.0.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0",
    "vite": "^7.0.0"
  }
}
